# Copiá este archivo a `.env` y rellená lo que necesites.
# `.env` nunca debe subirse a ningún repositorio.

# Proveedor activo: openai | anthropic
LLM_PROVIDER=openai

# Vacío = modelo por defecto (openai: gpt-4o-mini · anthropic: claude-sonnet-5)
LLM_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# El SDK de OpenAI habla un protocolo, no sólo con OpenAI: con una clave de
# Google AI Studio (gratuita) podés correr esto mismo contra Gemini.
#   LLM_PROVIDER=openai
#   LLM_MODEL=gemini-3.6-flash
#   OPENAI_API_KEY=<tu clave AIza...>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=

# temperature=0 por defecto: queremos extracción consistente, no creativa.
LLM_TEMPERATURE=0.0
